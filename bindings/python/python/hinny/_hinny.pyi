from collections.abc import Iterable, Mapping, Sequence
from os import PathLike
from typing import Any, Literal

__version__: str

Vector = Sequence[float] | Any  # a 1-D NumPy array (float32 is read in place) or a sequence of numbers
AttrValue = int | float | str
Tags = Sequence[str] | set[str] | frozenset[str]  # a tags attribute's value: read back as a sorted list

class Filter:
    """A condition on attributes; combine with &, | and ~."""
    def __and__(self, other: Filter) -> Filter: ...
    def __or__(self, other: Filter) -> Filter: ...
    def __invert__(self) -> Filter: ...

class Attr:
    """An attribute to filter on: attr("kind") == "pdf", attr("year") >= 2025."""
    def __eq__(self, value: AttrValue) -> Filter: ...  # type: ignore[override]
    def __ne__(self, value: AttrValue) -> Filter: ...  # type: ignore[override]
    def __ge__(self, value: int | float) -> Filter: ...
    def __gt__(self, value: int | float) -> Filter: ...
    def __le__(self, value: int | float) -> Filter: ...
    def __lt__(self, value: int | float) -> Filter: ...
    def between(self, low: int | float, high: int | float) -> Filter: ...
    def one_of(self, values: Iterable[AttrValue]) -> Filter: ...
    def has(self, tag: str) -> Filter:
        """A tags attribute has this tag (the same as ==)."""
    def has_any(self, tags: Iterable[str]) -> Filter: ...
    def has_all(self, tags: Iterable[str]) -> Filter: ...
    def prefix(self, prefix: str) -> Filter: ...
    def contains(self, part: str) -> Filter:
        """Contains these characters, ignoring case (on tags: one of them does)."""
    def glob(self, pattern: str) -> Filter:
        """The whole string matches the pattern: `*` is any run of characters, `?` any one,
        a backslash takes the next as itself (on tags: one of them matches)."""
    def iglob(self, pattern: str) -> Filter:
        """`glob`, whatever the case."""
    def exists(self) -> Filter: ...

def attr(name: str) -> Attr: ...
def key(id: str) -> int:
    """A stable integer key for a string id."""

class Hit:
    key: int
    score: float
    text_score: float | None
    vector_score: float | None
    attrs: dict[str, AttrValue]
    text: dict[str, str]
    """Stored text by field (empty with `with_text=False`, or a schema with `store_text=False`)."""
    snippet: str | None
    """The best-matching part of the best-matching field, about `snippet` characters."""
    snippet_field: str | None
    highlights: list[tuple[int, int]]
    """(start, end) of the query's words in `snippet`: `snippet[start:end]`."""

class Namespace:
    @property
    def name(self) -> str: ...
    @property
    def schema(self) -> dict[str, Any]: ...
    def upsert(self, key: int, text: str | Mapping[str, str] | None = None, attrs: Mapping[str, AttrValue | Tags] | None = None, vector: Vector | None = None, version: int = 0, sparse: Mapping[str, Mapping[str, float]] | None = None) -> None: ...
    def upsert_many(self, docs: Iterable[Mapping[str, Any]]) -> int: ...
    def apply(self, upsert: Iterable[Mapping[str, Any]] | None = None, delete: Iterable[int] | None = None) -> int:
        """Upserts and deletes as one batch: all or none of it, and no query sees part of it."""
    def delete(self, key: int) -> None: ...
    def delete_many(self, keys: Iterable[int]) -> int: ...
    def get(self, key: int) -> dict[str, AttrValue] | None: ...
    def text(self, key: int) -> dict[str, str] | None: ...
    def snapshot(self) -> Snapshot:
        """The namespace as of now: reads on it see exactly the writes before it, for as long as it's kept."""
    def versions(self) -> dict[int, int]: ...
    def count(self, filter: Filter | None = None) -> int:
        """How many documents pass `filter` (every document, without one)."""
    def delete_where(self, filter: Filter) -> int:
        """Deletes every document that passes `filter` now (all or, on an error, none); returns how many."""
    def patch(self, key: int, text: Mapping[str, str] | None = None, attrs: Mapping[str, AttrValue | Tags] | None = None, vector: Vector | None = None, version: int | None = None, remove: Sequence[str] = (), condition: Filter | None = None, sparse: Mapping[str, Mapping[str, float]] | None = None) -> bool:
        """Changes part of a document and keeps the rest: the text fields, attributes, sparse fields and vector given are replaced, the names in `remove` taken away.

        In a namespace with sparse fields, a patch gives each one's terms again in `sparse` or names it in `remove` (they aren't kept as given); one that does neither raises ValueError.
        With `condition`, only if the document passes it. False, and nothing written, if there is no such document or it doesn't pass."""
    def patch_where(self, filter: Filter, text: Mapping[str, str] | None = None, attrs: Mapping[str, AttrValue | Tags] | None = None, vector: Vector | None = None, version: int | None = None, remove: Sequence[str] = (), sparse: Mapping[str, Mapping[str, float]] | None = None) -> int:
        """`patch` for every document that passes `filter` now; returns how many that was."""
    def upsert_if(self, key: int, condition: Filter, text: str | Mapping[str, str] | None = None, attrs: Mapping[str, AttrValue | Tags] | None = None, vector: Vector | None = None, version: int = 0, sparse: Mapping[str, Mapping[str, float]] | None = None) -> bool:
        """`upsert`, unless a document with this key is there and fails `condition`; returns whether it was written."""
    def delete_if(self, key: int, condition: Filter) -> bool:
        """`delete`, only if the document exists and passes `condition`; returns whether it was deleted."""
    def count_by(self, attr: str, filter: Filter | None = None, limit: int = 0) -> list[tuple[AttrValue, int]]:
        """How many documents have each value of an attribute, among those that pass `filter`: the most frequent first, at most `limit` (0: every value)."""
    def sync(self) -> None:
        """Synchronize prior writes to storage without building segments; raises on I/O errors."""
        ...
    def flush(self) -> None: ...
    def fork(self, name: str) -> Namespace:
        """A namespace of its own in the same database, holding what this one holds now.

        The two are apart from then on. Takes milliseconds whatever the size, and no more disk
        until they differ. Raises FileExistsError if there is a namespace of that name."""
        ...
    def optimize(self) -> None:
        """Flushes and merges everything into one segment, the fastest layout after a bulk load."""
    def verify(self) -> dict[str, int]:
        """Reads every file on disk against its checksums; raises OSError naming the first damaged one."""
    def stats(self) -> dict[str, Any]: ...
    def set_limits(self, max_batch_bytes: int | None = None, flush_bytes: int | None = None) -> None: ...
    def __len__(self) -> int: ...
    def query(self, text: str | None = None, vector: Vector | None = None, filter: Filter | None = None, limit: int = 10, order_by: str | None = None, all_words: bool = False, nprobe: int = 0, snippet: int = 240, with_text: bool = True, text_weight: float = 0.5, fusion: Literal["convex", "rrf"] = "convex", sparse: Mapping[str, Mapping[str, float]] | None = None, text_candidates: int = 0, vector_candidates: int = 0, sparse_candidates: int = 0, timeout: float | None = None, typing: int = 0) -> list[Hit]: ...
    def explain(self, text: str | None = None, vector: Vector | None = None, filter: Filter | None = None, limit: int = 10, order_by: str | None = None, all_words: bool = False, nprobe: int = 0, snippet: int = 240, with_text: bool = True, text_weight: float = 0.5, fusion: Literal["convex", "rrf"] = "convex", sparse: Mapping[str, Mapping[str, float]] | None = None, text_candidates: int = 0, vector_candidates: int = 0, sparse_candidates: int = 0, timeout: float | None = None, typing: int = 0) -> dict[str, Any]: ...

class Snapshot:
    def query(self, text: str | None = None, vector: Vector | None = None, filter: Filter | None = None, limit: int = 10, order_by: str | None = None, all_words: bool = False, nprobe: int = 0, snippet: int = 240, with_text: bool = True, text_weight: float = 0.5, fusion: Literal["convex", "rrf"] = "convex", sparse: Mapping[str, Mapping[str, float]] | None = None, text_candidates: int = 0, vector_candidates: int = 0, sparse_candidates: int = 0, timeout: float | None = None, typing: int = 0) -> list[Hit]: ...
    def explain(self, text: str | None = None, vector: Vector | None = None, filter: Filter | None = None, limit: int = 10, order_by: str | None = None, all_words: bool = False, nprobe: int = 0, snippet: int = 240, with_text: bool = True, text_weight: float = 0.5, fusion: Literal["convex", "rrf"] = "convex", sparse: Mapping[str, Mapping[str, float]] | None = None, text_candidates: int = 0, vector_candidates: int = 0, sparse_candidates: int = 0, timeout: float | None = None, typing: int = 0) -> dict[str, Any]: ...
    def get(self, key: int) -> dict[str, AttrValue] | None: ...
    def text(self, key: int) -> dict[str, str] | None: ...
    def versions(self) -> dict[int, int]: ...
    def count(self, filter: Filter | None = None) -> int: ...
    def count_by(self, attr: str, filter: Filter | None = None, limit: int = 0) -> list[tuple[AttrValue, int]]: ...
    @property
    def seq(self) -> int: ...

class Database:
    def __init__(self, path: str | PathLike[str]) -> None: ...
    def namespace(self, name: str, text: str | Sequence[str] | Mapping[str, float] | None = None, ints: Sequence[str] = ..., strings: Sequence[str] = ..., vector: int | None = None, store_text: bool = True, language: str | None = None, stopwords: bool = True, sparse: Sequence[str] = ..., floats: Sequence[str] = ..., tags: Sequence[str] = ..., metric: Literal["cosine", "euclidean", "dot"] = "cosine") -> Namespace:
        """Opens a namespace, or creates it with this schema. `metric` is how vectors are compared, fixed once set: a hit's vector score is the cosine, the squared distance negated, or the dot product."""
    def open(self, name: str) -> Namespace:
        """Opens a namespace that exists, with the schema it has; raises if there is none of that name."""
    def namespaces(self) -> list[str]: ...
    def delete(self, name: str) -> None:
        """Deletes a namespace and everything in it; raises OSError if it is still open (let go of its `Namespace` and `Snapshot` objects first) or there is none of that name."""
